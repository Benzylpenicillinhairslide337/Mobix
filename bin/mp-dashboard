#!/usr/bin/env python3
"""
Web dashboard for the MuMu pentest lab.

One page fronting every service: device/emulator state, frida-server, proxy, CA,
the hooked app, live captured requests, and links into mitmweb / MobSF.

Bound to 127.0.0.1 only. It shells out to `mp`, so it must never be exposed on a
routable interface — actions are a fixed whitelist and arguments are validated,
but the blast radius of a remote caller would still be the whole toolkit.

  mp dash            start on http://127.0.0.1:8090
  mp dash --port N   different port
"""
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse
import urllib.request
import urllib.error
import time

ROOT = Path(os.environ.get("MP_ROOT", Path.home() / "mobile-pentest"))
MP = str(ROOT / "bin" / "mp")
SCRIPTS = ROOT / "scripts"
LOOT = ROOT / "loot"
APKS = ROOT / "apks"

PKG_RE = re.compile(r"^[A-Za-z0-9_.]{1,128}$")
HOST_RE = re.compile(r"^[A-Za-z0-9_.,:-]{0,200}$")
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def sh(cmd: list[str], timeout: int = 120) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, ANSI.sub("", (p.stdout or "") + (p.stderr or ""))
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s"
    except Exception as e:
        return 1, str(e)


def env():
    """Resolve the device serial the same way the shell scripts do."""
    rc, out = sh(["bash", "-c", f'. "{SCRIPTS}/env.sh"; echo "$MP_DEVICE"'], 20)
    return out.strip().splitlines()[-1] if out.strip() else "emulator-5554"


def adb(args: list[str], timeout: int = 20) -> str:
    return sh(["adb", "-s", env(), *args], timeout)[1]


def conf() -> dict:
    d = {}
    f = ROOT / "config"
    if f.exists():
        for line in f.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                d[k.strip()] = v.strip().strip('"')
    return d


def active_session() -> Path | None:
    """Where to read traffic from.

    Prefer the session the running proxy is writing to, but only once it has
    actually captured something - a live session that is still empty (or is
    scoped so nothing matches) would otherwise hide every earlier session and
    make analysis fail with "no request #N".
    """
    live = None
    rc, out = sh(["bash", "-c",
                  "ps -eo args | grep '[m]itmdump' | tr ' ' '\\n' | grep -m1 '^feedout=' | cut -d= -f2-"], 15)
    p = out.strip().splitlines()
    if p and p[-1]:
        live = Path(p[-1])
        f = live / "flows.jsonl"
        if f.exists() and f.stat().st_size:
            return live
    for d in sorted(LOOT.glob("session-*"), key=lambda x: x.stat().st_mtime, reverse=True):
        f = d / "flows.jsonl"
        if f.exists() and f.stat().st_size:
            return d
    return live


def port_open(port: int) -> bool:
    import socket
    with socket.socket() as s:
        s.settimeout(0.4)
        return s.connect_ex(("127.0.0.1", port)) == 0


def status() -> dict:
    dev = env()
    online = "device" in adb(["get-state"], 8)
    c = conf()
    st = {
        "device": dev if online else None,
        "online": online,
        "android": adb(["shell", "getprop", "ro.build.version.release"], 8).strip() if online else "",
        "abi": adb(["shell", "getprop", "ro.product.cpu.abi"], 8).strip() if online else "",
        "root": online and adb(["shell", "id", "-u"], 8).strip() == "0",
        "frida": online and bool(adb(["shell", "pgrep", "-f", "frida-server"], 8).strip()),
        "proxy": adb(["shell", "settings", "get", "global", "http_proxy"], 8).strip() if online else "",
        "ca": online and "No such" not in adb(["shell", "ls", "/system/etc/security/cacerts/c8750f0d.0"], 8),
        "target": c.get("TARGET", ""),
        "scope": c.get("SCOPE", ""),
        "hooks": sh(["bash", "-c", "pgrep -f 'frida -U -[fn] ' >/dev/null && echo 1 || echo 0"], 10)[1].strip().endswith("1"),
        "capture": port_open(8080),
        "mitmweb": port_open(8081),
        "mobsf": port_open(8010),
    }
    s = active_session()
    st["session"] = s.name if s else None
    st["flows"] = sum(1 for _ in (s / "flows.jsonl").open()) if s and (s / "flows.jsonl").exists() else 0
    return st


def emulator_apps() -> list[dict]:
    """Third-party packages installed ON THE EMULATOR (never host/macOS apps)."""
    out = adb(["shell", "pm", "list", "packages", "-3"], 25)
    pkgs = sorted(l.replace("package:", "").strip()
                  for l in out.splitlines() if l.startswith("package:"))
    running = adb(["shell", "ps", "-A", "-o", "NAME"], 20)
    return [{"pkg": p, "running": p in running} for p in pkgs if PKG_RE.match(p)]


ID_HEX_LENS = (24, 36)


def fold_path(path: str) -> str:
    """/user/6a71b30c8044c1e18603a745 -> /user/{id} - same folding used by
    brief.py, so the tree and the ranked brief agree on what an "endpoint" is."""
    out = []
    for seg in (path or "").split("/"):
        if seg.isdigit() or (len(seg) in ID_HEX_LENS and all(c in "0123456789abcdef-" for c in seg.lower())):
            out.append("{id}")
        else:
            out.append(seg)
    return "/".join(out)


def build_tree(rows: list[dict]) -> dict:
    """host -> nested path-segment tree with per-node hit counts. IDs are
    folded to {id} so /user/111 and /user/222 land on the same branch."""
    tree: dict = {}
    for r in rows:
        host = r.get("host") or "(unknown)"
        hnode = tree.setdefault(host, {"count": 0, "children": {}})
        hnode["count"] += 1
        cur = hnode
        for seg in [s for s in (r.get("tmpl") or "").split("/") if s]:
            cur = cur["children"].setdefault(seg, {"count": 0, "children": {}})
            cur["count"] += 1
    return tree


def resolve_session(name: str = "") -> Path | None:
    """An explicit archived session name, or the live one if blank/unmatched."""
    if name:
        p = LOOT / name
        if p.is_dir() and re.match(r"^session-[0-9-]+$", name):
            return p
    return active_session()


def session_target(d: Path) -> str:
    tf = d / ".target"
    if tf.exists():
        return tf.read_text().strip()
    # older sessions predate tagging - fall back to the dominant app in flows.jsonl
    f = d / "flows.jsonl"
    if not f.exists():
        return ""
    counts: dict[str, int] = {}
    try:
        for line in f.open():
            try:
                r = json.loads(line)
            except Exception:
                continue
            a = r.get("app") or ""
            if a:
                counts[a] = counts.get(a, 0) + 1
    except Exception:
        pass
    return max(counts, key=counts.get) if counts else ""


def list_sessions_full() -> list[dict]:
    out = []
    live = active_session()
    for d in sorted(LOOT.glob("session-*"), key=lambda p: p.stat().st_mtime, reverse=True):
        if not d.is_dir():
            continue
        f = d / "flows.jsonl"
        flows = 0
        if f.exists():
            try:
                flows = sum(1 for _ in f.open())
            except Exception:
                pass
        out.append({
            "name": d.name, "target": session_target(d), "flows": flows,
            "mtime": d.stat().st_mtime, "has_brief": (d / "BRIEF.md").exists(),
            "live": live is not None and d.resolve() == live.resolve(),
        })
    return out


def list_engagements_full() -> list[dict]:
    out = []
    base = ROOT / "engagements"
    if not base.exists():
        return out
    for d in sorted((p for p in base.glob("*") if p.is_dir()),
                     key=lambda p: p.stat().st_mtime, reverse=True):
        pkg = d.name.rsplit("_", 1)[0] if "_" in d.name else d.name
        sid_f = d / ".session_id"
        mode_f = d / ".mode"
        sid = sid_f.read_text().strip() if sid_f.exists() else ""
        mode = mode_f.read_text().strip() if mode_f.exists() else ("auto" if (d / ".agent.pid").exists() else "")
        fdir = d / "findings"
        findings = len(list(fdir.glob("*.md"))) if fdir.exists() else 0
        running = False
        pidf = d / ".agent.pid"
        if pidf.exists():
            try:
                os.kill(int(pidf.read_text().strip()), 0); running = True
            except Exception:
                running = False
        out.append({
            "name": d.name, "pkg": pkg, "mtime": d.stat().st_mtime,
            "session_id": sid, "mode": mode, "findings": findings, "running": running,
        })
    return out


def recent_requests(limit: int = 2000, app: str = "", session: str = "") -> list[dict]:
    s = resolve_session(session)
    if not s:
        return []
    f = s / "flows.jsonl"
    if not f.exists():
        return []
    rows = []
    for line in f.open():
        try:
            r = json.loads(line)
        except Exception:
            continue
        if app and (r.get("app") or "") != app:
            continue
        rows.append({
            "i": r.get("i"), "method": r.get("method"), "host": r.get("host"),
            "path": r.get("path"), "tmpl": fold_path(r.get("path") or ""),
            "status": r.get("status"),
            "app": r.get("app") or "", "auth": r.get("auth_scheme") or "",
            "flags": ",".join(r.get("flag_types") or []),
        })
    return rows[-limit:][::-1]


def flow_detail(i: int, session: str = "") -> dict:
    """Everything captured for one request, with base64 bodies decoded."""
    sess = resolve_session(session)
    if not sess:
        return {}
    f = sess / "flows.jsonl"
    if not f.exists():
        return {}
    for line in f.open():
        try:
            r = json.loads(line)
        except Exception:
            continue
        if r.get("i") != i:
            continue

        def unpack(txt):
            """Some APIs wrap the real payload in a base64 field; surface it."""
            out = []
            if not txt:
                return out
            try:
                doc = json.loads(txt)
            except Exception:
                return out
            if isinstance(doc, dict):
                for k in ("requestBody", "responseBody", "data", "payload"):
                    v = doc.get(k)
                    if isinstance(v, str) and len(v) > 8:
                        try:
                            import base64
                            dec = base64.b64decode(v, validate=True).decode("utf-8", "replace")
                            if dec.strip()[:1] in "[{\"":
                                try:
                                    dec = json.dumps(json.loads(dec), ensure_ascii=False, indent=2)
                                except Exception:
                                    pass
                                out.append({"field": k, "decoded": dec[:20000]})
                        except Exception:
                            pass
            return out

        def pretty(txt):
            if not txt:
                return ""
            try:
                return json.dumps(json.loads(txt), ensure_ascii=False, indent=2)
            except Exception:
                return txt

        r["req_pretty"] = pretty(r.get("req_body"))
        r["res_pretty"] = pretty(r.get("res_body"))
        r["req_decoded"] = unpack(r.get("req_body"))
        r["res_decoded"] = unpack(r.get("res_body"))
        return r
    return {}


CLAUDE = shutil.which("claude")


def analyze_with_claude(kind: str, index: str) -> tuple[bool, str]:
    """Send captured traffic to Claude Code headlessly and return its analysis.

    The data is inlined into the prompt so the run is self-contained; the
    mp-traffic MCP server is the interactive path for a live session.
    """
    if not CLAUDE:
        return False, "claude CLI not found on PATH"
    sess = active_session()
    if not sess:
        return False, "no capture session with traffic"

    if kind == "flow":
        try:
            i = int(index)
        except (TypeError, ValueError):
            return False, "invalid flow index"
        d = flow_detail(i)
        if not d:
            return False, f"no request #{i}"
        payload = json.dumps(d, indent=2, ensure_ascii=False)[:60000]
        prompt = (
            "You are assisting an authorised mobile application penetration test.\n"
            "Analyse this single intercepted HTTP request/response.\n\n"
            "Identify: what the endpoint does; the authentication and authorisation model; "
            "any sensitive data exposed; concrete vulnerability candidates (broken access "
            "control, IDOR/BOLA, mass assignment, injection, secrets in transit); and the "
            "single highest-value next test with the exact modification to make.\n"
            "Be specific and concise. Do not speculate beyond the evidence.\n\n"
            f"```json\n{payload}\n```"
        )
    else:
        subprocess.run(["python3", str(SCRIPTS / "brief.py"), str(sess)],
                       capture_output=True, text=True, timeout=180)
        bf = sess / "BRIEF.md"
        if not bf.exists():
            return False, "could not build the brief"
        brief = bf.read_text()[:60000]
        prompt = (
            "You are assisting an authorised mobile application penetration test.\n"
            "Below is a ranked brief generated from intercepted traffic.\n\n"
            "Give: (1) the three highest-value things to test next, each with the specific "
            "request to send and what result would confirm a finding; (2) anything in the "
            "traffic that already looks like a defect; (3) what coverage is missing.\n"
            "Be concrete and brief. Do not invent endpoints that are not listed.\n\n"
            + brief
        )

    try:
        p = subprocess.run([CLAUDE, "-p", prompt], capture_output=True, text=True,
                           timeout=600, cwd=str(ROOT))
    except subprocess.TimeoutExpired:
        return False, "claude timed out after 600s"
    out = (p.stdout or "").strip() or (p.stderr or "").strip()
    return (p.returncode == 0 and bool(out)), out or "claude returned nothing"


def install_log_path():
    return LOOT / "install.log"


def scan_log_path():
    return LOOT / "newscan.log"


def run_new_scan(source: str, scope: str):
    """Kick off `mp scan` (optionally preceded by `mp scope`) in the
    background, streaming combined output to newscan.log for the New Scan
    modal to poll. This is the dashboard's front door for starting a scan -
    it drives the exact same `mp scan` used from the CLI, so the two
    surfaces behave identically rather than duplicating the logic."""
    log = scan_log_path()
    log.parent.mkdir(parents=True, exist_ok=True)
    def go():
        with open(log, "w") as f:
            if scope:
                f.write(f"$ mp scope {scope}\n")
                f.flush()
                subprocess.run([MP, "scope", scope], stdout=f, stderr=subprocess.STDOUT)
            args = [MP, "scan"] + ([source] if source else [])
            f.write("\n$ mp scan" + (f" {source}" if source else "") + "\n\n")
            f.flush()
            try:
                proc = subprocess.Popen(args, stdout=f, stderr=subprocess.STDOUT)
                proc.wait()
                f.write("\n[scan finished]\n" if proc.returncode == 0 else f"\n[scan exited {proc.returncode}]\n")
            except Exception as e:
                f.write(f"\n[error] {e}\n")
    threading.Thread(target=go, daemon=True).start()


def run_install(source: str, passive: bool):
    args = [str(SCRIPTS / "install-app.sh"), source]
    if passive:
        args.append("--passive")
    log = install_log_path()
    log.parent.mkdir(parents=True, exist_ok=True)
    def go():
        with open(log, "w") as f:
            f.write(f"$ install-app.sh {source}{' --passive' if passive else ''}\n\n")
            f.flush()
            try:
                proc = subprocess.Popen(args, stdout=f, stderr=subprocess.STDOUT)
                proc.wait()
                f.write("\n[install finished]\n")
            except Exception as e:
                f.write(f"\n[error] {e}\n")
    threading.Thread(target=go, daemon=True).start()


def save_upload(headers, rfile) -> str:
    """Minimal multipart/form-data parser — saves the first file part.

    cgi is gone in 3.13, so parse by hand: split the body on the boundary and
    pull the part that carries a filename.
    """
    ctype = headers.get("Content-Type", "")
    if "boundary=" not in ctype:
        raise ValueError("not multipart")
    boundary = ("--" + ctype.split("boundary=", 1)[1].strip()).encode()
    length = int(headers.get("Content-Length") or 0)
    body = rfile.read(length)
    for part in body.split(boundary):
        head, _, data = part.partition(b"\r\n\r\n")
        if b"filename=" not in head:
            continue
        fn = head.split(b"filename=", 1)[1].split(b"\r\n", 1)[0].strip().strip(b'"').decode("utf-8", "replace")
        fn = os.path.basename(fn) or "upload.apk"
        if not re.match(r"^[\w.\- ]{1,120}$", fn):
            fn = "upload.apk"
        data = data.rsplit(b"\r\n", 1)[0]   # drop trailing CRLF before boundary
        dest = APKS / "uploads"
        dest.mkdir(parents=True, exist_ok=True)
        out = dest / fn
        out.write_bytes(data)
        return str(out)
    raise ValueError("no file part found")


def engagement_status() -> dict:
    base = ROOT / "engagements"
    engs = sorted(base.glob("*"), key=lambda p: p.stat().st_mtime, reverse=True) if base.exists() else []
    engs = [e for e in engs if e.is_dir()]
    if not engs:
        return {"engagement": None}
    e = engs[0]

    # Running if the --auto agent pid is alive, OR an interactive claude session
    # for this engagement is still open (interactive sessions write no pidfile).
    running = False
    pidf = e / ".agent.pid"
    if pidf.exists():
        try:
            os.kill(int(pidf.read_text().strip()), 0); running = True
        except Exception:
            running = False
    if not running:
        try:
            ps = subprocess.run(["bash", "-c", "ps -eo args"], capture_output=True, text=True).stdout
            running = ("authorised security review" in ps) or (e.name in ps)
        except Exception:
            pass

    def severity(text: str) -> str:
        m = re.search(r"(?im)^\**\s*severity\**\s*[:=]\s*\**\s*([A-Za-z/ -]+)", text)
        if m:
            return m.group(1).strip().split()[0].capitalize()
        low = text.lower()
        for sev in ("critical", "high", "medium", "low", "info"):
            if sev in low:
                return sev.capitalize()
        return ""

    findings = []
    fd = e / "findings"
    if fd.exists():
        files = [f for f in fd.glob("*.md") if f.name != "README.md"]
        files.sort(key=lambda f: f.stat().st_mtime, reverse=True)   # newest first
        import time as _t
        now = _t.time()
        for f in files:
            try:
                txt = f.read_text()
            except Exception:
                txt = ""
            title = ""
            for line in txt.splitlines():
                if line.startswith("#"):
                    title = line.lstrip("# ").strip(); break
            mt = f.stat().st_mtime
            findings.append({
                "file": f.name,
                "title": title or f.stem,
                "severity": severity(txt),
                "mtime": int(mt),
                "age_min": int((now - mt) / 60),
            })

    tail = ""
    log = e / "scan.log"
    if log.exists():
        try:
            txt = subprocess.run(["tail", "-c", "4000", str(log)], capture_output=True, text=True).stdout
            msgs = []
            for ln in txt.splitlines():
                try:
                    ev = json.loads(ln)
                except Exception:
                    continue
                if ev.get("type") == "assistant":
                    for b in ev.get("message", {}).get("content", []):
                        if b.get("type") == "text" and b.get("text", "").strip():
                            msgs.append(b["text"].strip())
                        elif b.get("type") == "tool_use":
                            msgs.append("· " + b.get("name", ""))
            tail = "\n".join(msgs[-8:])
        except Exception:
            pass

    return {
        "engagement": e.name,
        "running": running,
        "mode": "auto" if pidf.exists() else "interactive",
        "findings": findings,
        "latest": findings[0] if findings else None,
        "activity": tail,
    }


_SIGNER = None
_SIGNER_TRIED = False


_CREDS_MOD = None


def creds_mod():
    """Lazily load scripts/creds.py - same trick as repeater_signer(), so
    storage format/TOTP/adb-typing logic has exactly one implementation
    shared by the CLI (`mp login`/`mp creds`) and this dashboard."""
    global _CREDS_MOD
    if _CREDS_MOD is None:
        import importlib.util
        path = SCRIPTS / "creds.py"
        spec = importlib.util.spec_from_file_location("mp_creds", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _CREDS_MOD = mod
    return _CREDS_MOD


def repeater_signer():
    """Lazily load compute_macin() from scripts/zc-macin.py, same trick the
    generated replay.py harnesses use. Returns None if the script or the
    'cryptography' package it needs isn't available - callers just skip
    re-signing in that case rather than failing the whole send."""
    global _SIGNER, _SIGNER_TRIED
    if _SIGNER_TRIED:
        return _SIGNER
    _SIGNER_TRIED = True
    try:
        import importlib.util
        path = SCRIPTS / "zc-macin.py"
        if path.exists():
            spec = importlib.util.spec_from_file_location("zc_macin", path)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _SIGNER = mod.compute_macin
    except Exception:
        _SIGNER = None
    return _SIGNER


def repeater_send(method: str, url: str, headers: dict, body: str, resign: bool) -> dict:
    """Actually transmit an (edited) request and return the raw response.
    Sent directly from this host, not through the emulator - the captured
    APIs are ordinary internet endpoints, so no device hop is needed."""
    resigned = False
    if resign and body:
        try:
            doc = json.loads(body)
            if isinstance(doc, dict) and "macIn" in doc:
                signer = repeater_signer()
                if signer:
                    doc["macIn"] = signer(doc)
                    body = json.dumps(doc, separators=(",", ":"))
                    resigned = True
        except Exception:
            pass

    data = body.encode("utf-8") if body else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=25) as resp:
            raw = resp.read(300000)
            return {"ok": True, "status": resp.status,
                    "headers": dict(resp.headers.items()),
                    "body": raw.decode("utf-8", "replace"),
                    "resigned": resigned, "elapsed_ms": int((time.time() - t0) * 1000)}
    except urllib.error.HTTPError as e:
        raw = e.read(300000)
        return {"ok": True, "status": e.code,
                "headers": dict(e.headers.items()) if e.headers else {},
                "body": raw.decode("utf-8", "replace"),
                "resigned": resigned, "elapsed_ms": int((time.time() - t0) * 1000)}
    except Exception as e:
        return {"ok": False, "error": str(e), "resigned": resigned,
                "elapsed_ms": int((time.time() - t0) * 1000)}


def bypass_catalog() -> dict:
    rc, out = sh(["python3", str(SCRIPTS / "bypass.py"), "--list"], 30)
    try:
        return json.loads(out[out.index("{"):])
    except Exception:
        return {"scripts": [], "anti": [], "anti_enabled": True}


def bypass_set(key: str, on: bool) -> tuple[bool, str]:
    if not re.match(r"^(anti\.)?[A-Za-z0-9_.-]{1,40}$", key or ""):
        return False, "invalid module key"
    rc, out = sh(["python3", str(SCRIPTS / "bypass.py"),
                  "--set", f"{key}={'1' if on else '0'}"], 30)
    return rc == 0, ("" if rc == 0 else out)


def apps_in_session(session: str = "") -> list[dict]:
    s = resolve_session(session)
    if not s or not (s / "flows.jsonl").exists():
        return []
    counts: dict[str, int] = {}
    for line in (s / "flows.jsonl").open():
        try:
            r = json.loads(line)
        except Exception:
            continue
        counts[r.get("app") or "(background)"] = counts.get(r.get("app") or "(background)", 0) + 1
    return [{"app": k, "flows": v} for k, v in sorted(counts.items(), key=lambda kv: -kv[1])]


# Whitelisted actions. Nothing here interpolates free-form user input into a shell.
def run_action(action: str, arg: str) -> tuple[bool, str]:
    if action in ("up", "down", "stop", "brief", "analyze", "seen", "status"):
        rc, out = sh([MP, action], 300)
        return rc == 0, out
    if action == "go":
        threading.Thread(target=lambda: sh([MP, "go"], 400), daemon=True).start()
        return True, "starting: boot emulator if needed, hook target, start capture…"
    if action == "capture":
        threading.Thread(target=lambda: sh([MP, "capture", "dump"], 400), daemon=True).start()
        return True, "capture starting…"
    if action == "launch":
        pkg = arg or conf().get("TARGET", "")
        if not PKG_RE.match(pkg or ""):
            return False, "invalid package name"
        threading.Thread(target=lambda: sh([MP, "launch", pkg], 400), daemon=True).start()
        return True, f"launching {pkg} with bypasses…"
    if action == "target":
        if not PKG_RE.match(arg or ""):
            return False, "invalid package name"
        rc, out = sh([MP, "target", arg], 30)
        return rc == 0, out
    if action == "scope":
        if not HOST_RE.match(arg or ""):
            return False, "invalid scope"
        rc, out = sh([MP, "scope", arg] if arg else [MP, "scope", ""], 30)
        return rc == 0, out
    if action == "switch":
        pkg = arg or conf().get("TARGET", "")
        if not PKG_RE.match(pkg or ""):
            return False, "invalid package name"
        threading.Thread(target=lambda: sh([MP, "switch", pkg], 500), daemon=True).start()
        return True, f"switching to {pkg}: stopping old capture, starting fresh session, hooking…"
    if action == "engage_auto":
        pkg = conf().get("TARGET", "")
        rc, out = sh([MP, "engage", pkg, "--auto"], 120)
        return rc == 0, out
    if action == "engage_open":
        pkg = conf().get("TARGET", "")
        rc, out = sh([MP, "engage", pkg], 60)
        return rc == 0, out
    if action == "engage_stop":
        rc, out = sh([MP, "engage", "--stop"], 60)
        return rc == 0, out
    if action == "engage_resume":
        name = arg.strip()
        if not re.match(r"^[A-Za-z0-9_.-]{1,160}$", name) or not (ROOT / "engagements" / name).is_dir():
            return False, "unknown engagement"
        rc, out = sh([MP, "engage", "--resume", name], 30)
        return rc == 0, out
    if action in ("analyze_session", "analyze_flow"):
        return analyze_with_claude("flow" if action == "analyze_flow" else "session", arg)
    if action == "bypass":
        key, _, val = arg.partition("=")
        ok, err = bypass_set(key, val not in ("0", "false", ""))
        return ok, err or f"{key} -> {'on' if val not in ('0','false','') else 'off'} (applies on next launch)"
    if action == "bypass_reset":
        rc, out = sh(["python3", str(SCRIPTS / "bypass.py"), "--reset"], 30)
        return rc == 0, "all bypass modules re-enabled"
    if action == "mobsf":
        threading.Thread(target=lambda: sh([MP, "mobsf", "start"], 300), daemon=True).start()
        return True, "MobSF starting…"
    if action == "burp_switch":
        port = arg.strip() or "8080"
        if not port.isdigit() or not (1 <= int(port) <= 65535):
            return False, "invalid port"
        rc, out = sh([MP, "burp", port], 30)
        return rc == 0, out
    if action == "burp_mitm":
        rc, out = sh([MP, "burp", "--mitm"], 30)
        return rc == 0, out
    if action == "pull":
        pkg = arg or conf().get("TARGET", "")
        if not PKG_RE.match(pkg or ""):
            return False, "invalid package name"
        rc, out = sh([MP, "pull", pkg], 600)
        return rc == 0, out
    if action == "web":
        s = active_session()
        if not s:
            return False, "no session yet"
        threading.Thread(target=lambda: sh(
            ["bash", "-c", f'"{MP}" web {arg or "*"} >/dev/null 2>&1'], 600), daemon=True).start()
        return True, "mitmweb starting on :8081 — check its console for the token URL"
    return False, f"unknown action: {action}"


