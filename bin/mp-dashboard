class H(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def log_message(self, *a):
        pass

    def do_GET(self):
        u = urlparse(self.path)
        if u.path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if u.path == "/api/status":
            return self._send(200, json.dumps(status()))
        if u.path == "/api/apps":
            return self._send(200, json.dumps(emulator_apps()))
        if u.path == "/api/seen":
            q = parse_qs(u.query)
            return self._send(200, json.dumps(apps_in_session(session=(q.get("session") or [""])[0])))
        if u.path == "/api/scan_status":
            lp = scan_log_path()
            txt = ""
            if lp.exists():
                import subprocess as _sp
                txt = _sp.run(["tail", "-c", "8000", str(lp)], capture_output=True, text=True).stdout
            ps = subprocess.run(["bash", "-c", "ps -eo args"], capture_output=True, text=True).stdout
            running = "bin/mp scan" in ps or "bin/mp scope" in ps
            return self._send(200, json.dumps({"log": ANSI.sub("", txt), "running": running}))
        if u.path == "/api/install_status":
            lp = install_log_path()
            txt = ""
            if lp.exists():
                import subprocess as _sp
                txt = _sp.run(["tail", "-c", "8000", str(lp)], capture_output=True, text=True).stdout
            running = any("install-app.sh" in l for l in
                          __import__("subprocess").run(["bash","-c","ps -eo args"],capture_output=True,text=True).stdout.splitlines())
            return self._send(200, json.dumps({"log": ANSI.sub("", txt), "running": running}))
        if u.path == "/api/engagement":
            return self._send(200, json.dumps(engagement_status()))
        if u.path == "/api/finding":
            q = parse_qs(u.query)
            name = (q.get("file") or [""])[0]
            if not re.match(r"^[A-Za-z0-9_.-]{1,80}\.md$", name):
                return self._send(400, json.dumps({"error": "bad name"}))
            engs = sorted((ROOT / "engagements").glob("*"),
                          key=lambda p: p.stat().st_mtime, reverse=True)
            engs = [e for e in engs if e.is_dir()]
            if engs:
                f = engs[0] / "findings" / name
                if f.exists():
                    return self._send(200, json.dumps({"text": f.read_text()[:40000]}))
            return self._send(404, json.dumps({"error": "not found"}))
        if u.path == "/api/burp_status":
            q = parse_qs(u.query)
            port = (q.get("port") or ["8080"])[0]
            port = port if port.isdigit() else "8080"
            out = subprocess.run(["lsof", "-nP", "-iTCP:" + port, "-sTCP:LISTEN"],
                                 capture_output=True, text=True).stdout
            owner = "none"
            if "python" in out.lower():
                owner = "mitmproxy"
            elif "java" in out.lower():
                owner = "burp"
            elif out.strip():
                owner = "other"
            proxy = adb(["shell", "settings", "get", "global", "http_proxy"]).strip()
            return self._send(200, json.dumps({"port": port, "owner": owner, "device_proxy": proxy}))
        if u.path == "/api/creds":
            q = parse_qs(u.query)
            pkg = (q.get("pkg") or [""])[0]
            if not pkg:
                return self._send(400, json.dumps({"error": "pkg required"}))
            return self._send(200, json.dumps(creds_mod().load(pkg)))
        if u.path == "/api/totp":
            q = parse_qs(u.query)
            secret = (q.get("secret") or [""])[0]
            try:
                code, remaining = creds_mod().totp_now(secret)
                return self._send(200, json.dumps({"code": code, "remaining": remaining}))
            except Exception as e:
                return self._send(400, json.dumps({"error": str(e)}))
        if u.path == "/api/tree":
            q = parse_qs(u.query)
            app_f = (q.get("app") or [""])[0]
            sess_f = (q.get("session") or [""])[0]
            rows = recent_requests(app=app_f, session=sess_f)
            return self._send(200, json.dumps(build_tree(rows)))
        if u.path == "/api/bypass":
            return self._send(200, json.dumps(bypass_catalog()))
        if u.path == "/api/flow":
            q = parse_qs(u.query)
            try:
                i = int((q.get("i") or ["0"])[0])
            except ValueError:
                return self._send(400, json.dumps({"error": "bad index"}))
            sess_f = (q.get("session") or [""])[0]
            return self._send(200, json.dumps(flow_detail(i, session=sess_f)))
        if u.path == "/api/requests":
            q = parse_qs(u.query)
            sess_f = (q.get("session") or [""])[0]
            return self._send(200, json.dumps(recent_requests(app=(q.get("app") or [""])[0], session=sess_f)))
        if u.path == "/api/all_sessions":
            return self._send(200, json.dumps({"sessions": list_sessions_full(),
                                               "engagements": list_engagements_full()}))
        return self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        path = urlparse(self.path).path
        if path == "/api/upload_apk":
            try:
                saved = save_upload(self.headers, self.rfile)
                return self._send(200, json.dumps({"ok": True, "path": saved}))
            except Exception as e:
                return self._send(400, json.dumps({"ok": False, "out": str(e)}))
        if path == "/api/creds":
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                return self._send(400, json.dumps({"ok": False, "out": "bad json"}))
            pkg = str(body.get("pkg", "")).strip()
            if not pkg:
                return self._send(400, json.dumps({"ok": False, "out": "pkg required"}))
            fields = body.get("fields") or []
            clean = []
            for f in fields:
                label = str(f.get("label", "")).strip()
                if not label:
                    continue
                ftype = f.get("type") if f.get("type") in ("text", "password", "totp") else "text"
                clean.append({"label": label, "value": str(f.get("value", "")), "type": ftype})
            creds_mod().save(pkg, {"fields": clean, "notes": str(body.get("notes", ""))})
            return self._send(200, json.dumps({"ok": True, "out": "saved"}))
        if path == "/api/creds_type":
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                return self._send(400, json.dumps({"ok": False, "out": "bad json"}))
            text = str(body.get("text", ""))
            cm = creds_mod()
            r = cm.type_text(env(), text)
            if r.returncode != 0:
                return self._send(200, json.dumps({"ok": False, "out": r.stderr.strip() or "failed"}))
            return self._send(200, json.dumps({"ok": True, "out": f"sent {len(text)} chars to the focused field"}))
        if path == "/api/emulator_front":
            creds_mod().bring_front()
            return self._send(200, json.dumps({"ok": True, "out": "brought MuMu to the front"}))
        if path == "/api/repeater_send":
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                return self._send(400, json.dumps({"ok": False, "error": "bad json"}))
            method = str(body.get("method", "GET")).upper().strip() or "GET"
            url = str(body.get("url", "")).strip()
            if not url.startswith(("http://", "https://")):
                return self._send(400, json.dumps({"ok": False, "error": "url must start with http(s)://"}))
            hdrs = {}
            for line in str(body.get("headers", "")).splitlines():
                if ":" in line:
                    k, _, v = line.partition(":")
                    k = k.strip()
                    if k:
                        hdrs[k] = v.strip()
            result = repeater_send(method, url, hdrs, str(body.get("body", "")), bool(body.get("resign")))
            return self._send(200, json.dumps(result))
        if path == "/api/new_scan":
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                return self._send(400, json.dumps({"ok": False, "out": "bad json"}))
            src = str(body.get("source", "")).strip()
            scope = str(body.get("scope", "")).strip()
            run_new_scan(src, scope)
            return self._send(200, json.dumps({"ok": True, "out": "scan started"}))
        if path == "/api/install":
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                return self._send(400, json.dumps({"ok": False, "out": "bad json"}))
            src = str(body.get("source", "")).strip()
            if not src:
                return self._send(400, json.dumps({"ok": False, "out": "no source"}))
            # allow: http(s) url, market/play link, id=pkg, or a local path under the lab
            if not (src.startswith("http") or src.startswith("market:") or src.startswith("id=")
                    or src.startswith(str(ROOT)) or src.startswith("/") or "." in src):
                return self._send(400, json.dumps({"ok": False, "out": "unrecognised source"}))
            run_install(src, bool(body.get("passive")))
            return self._send(200, json.dumps({"ok": True, "out": "install started — watch the log"}))
        if path != "/api/action":
            return self._send(404, json.dumps({"error": "not found"}))
        n = int(self.headers.get("Content-Length") or 0)
        try:
            body = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self._send(400, json.dumps({"ok": False, "out": "bad json"}))
        ok, out = run_action(str(body.get("action", "")), str(body.get("arg", "")))
        return self._send(200, json.dumps({"ok": ok, "out": out}))


def main() -> int:
    port = 8090
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    if not shutil.which("adb"):
        print("adb not on PATH", file=sys.stderr)
        return 1
    srv = ThreadingHTTPServer(("127.0.0.1", port), H)   # localhost only, by design
    print(f"mp dashboard -> http://127.0.0.1:{port}")
    print("bound to localhost only; it can run mp commands, so do not expose it")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
