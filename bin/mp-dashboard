<script>
const $=id=>document.getElementById(id);
let ROWS=[], APPS=[], SEL='', CUR=null;
let TREEHOST=null, TREEPATH=[], TREE_OPEN=new Set(), TREE_INIT=false;
let LAST_TARGET=null;

function tkey(host,path){ return host+(path.length?'\u0001'+path.join('/'):''); }

function renderTreeChildren(node,host,path,depth){
  const entries=Object.entries(node.children||{}).sort((a,b)=>b[1].count-a[1].count);
  return entries.map(function(e){
    const name=e[0], child=e[1];
    const newPath=path.concat([name]);
    const key=tkey(host,newPath);
    const hasKids=Object.keys(child.children||{}).length>0;
    const open=TREE_OPEN.has(key);
    const isSel=TREEHOST===host && TREEPATH.join('/')===newPath.join('/');
    return '<div class="tnode">'
      +'<div class="trow'+(isSel?' sel':'')+'" style="padding-left:'+(8+depth*14)+'px" '
      +'data-host="'+esc(host)+'" data-path="'+esc(encodeURIComponent(JSON.stringify(newPath)))+'" data-key="'+esc(key)+'">'
      +'<span class="tcaret">'+(hasKids?(open?'▾':'▸'):'·')+'</span>'
      +'<span class="tname">'+esc(name)+'</span><span class="tcount">'+child.count+'</span></div>'
      +(hasKids?'<div class="tchildren" style="display:'+(open?'':'none')+'">'+renderTreeChildren(child,host,newPath,depth+1)+'</div>':'')
      +'</div>';
  }).join('');
}

async function loadTree(){
  const app=$('appfilter').value;
  const tree=await (await fetch('/api/tree'+(app?'?app='+encodeURIComponent(app):''))).json();
  const hosts=Object.entries(tree).sort(function(a,b){return b[1].count-a[1].count});
  if(!TREE_INIT){ hosts.forEach(function(h){TREE_OPEN.add(tkey(h[0],[]))}); TREE_INIT=true; }
  $('treePane').innerHTML=hosts.map(function(e){
    const host=e[0], node=e[1];
    const key=tkey(host,[]);
    const open=TREE_OPEN.has(key);
    const isSel=TREEHOST===host && TREEPATH.length===0;
    return '<div class="tnode">'
      +'<div class="trow thost'+(isSel?' sel':'')+'" data-host="'+esc(host)+'" data-path="'+esc(encodeURIComponent(JSON.stringify([])))+'" data-key="'+esc(key)+'">'
      +'<span class="tcaret">'+(open?'▾':'▸')+'</span><span class="tname">'+esc(host)+'</span><span class="tcount">'+node.count+'</span></div>'
      +'<div class="tchildren" style="display:'+(open?'':'none')+'">'+renderTreeChildren(node,host,[],1)+'</div></div>';
  }).join('')||'<div class="muted" style="padding:8px">no traffic yet</div>';
}

document.addEventListener('click', function(e){
  const row=e.target.closest('.trow');
  const pane=document.getElementById('treePane');
  if(!row||!pane||!pane.contains(row)) return;
  const host=row.dataset.host;
  const path=JSON.parse(decodeURIComponent(row.dataset.path));
  const key=row.dataset.key;
  if(TREE_OPEN.has(key)) TREE_OPEN.delete(key); else TREE_OPEN.add(key);
  treeFilter(host,path);
  loadTree();
});

function treeFilter(host,path){
  TREEHOST=host; TREEPATH=path;
  $('treechip').innerHTML=host?('<span class="tchip">'+esc(host)+(path.length?'/'+path.map(esc).join('/'):'')+' <a href="javascript:clearTreeFilter()">✕</a></span>'):'';
  render();
}
function clearTreeFilter(){ TREEHOST=null; TREEPATH=[]; $('treechip').innerHTML=''; render(); loadTree(); }

let REPHIST=[];
let CREDFIELDS=[], CREDPKG='', CREDTIMER=null;

async function loadCredsForCurrentTarget(){
  const st=await (await fetch('/api/status')).json();
  $('credPkg').value=st.target||'';
  if(st.target) loadCreds();
}
async function loadCreds(){
  const pkg=$('credPkg').value.trim();
  if(!pkg){ $('credRows').innerHTML='<div class="muted">enter a package name above</div>'; return; }
  CREDPKG=pkg;
  const d=await (await fetch('/api/creds?pkg='+encodeURIComponent(pkg))).json();
  CREDFIELDS=(d.fields||[]).map(function(f){return {label:f.label,value:f.value,type:f.type||'text'}});
  $('credNotes').value=d.notes||'';
  renderCredRows();
}
function addCredRow(){ CREDFIELDS.push({label:'',value:'',type:'text'}); renderCredRows(); }
function removeCredRow(i){ CREDFIELDS.splice(i,1); renderCredRows(); }
function updateCredField(i,key,val){ CREDFIELDS[i][key]=val; if(key==='type') renderCredRows(); }

function renderCredRows(){
  clearTimeout(CREDTIMER);
  $('credCount').textContent = CREDFIELDS.length? '('+CREDFIELDS.length+')' : '';
  if(!CREDFIELDS.length){
    $('credRows').innerHTML='<div class="muted" style="padding:8px 0">no fields yet — add one below</div>';
    return;
  }
  $('credRows').innerHTML=CREDFIELDS.map(function(f,i){
    const labelInput='<input value="'+escAttr(f.label)+'" placeholder="label" oninput="updateCredField('+i+',\'label\',this.value)">';
    const typeSelect='<select onchange="updateCredField('+i+',\'type\',this.value)">'
      +['text','password','totp'].map(function(t){return '<option value="'+t+'"'+(f.type===t?' selected':'')+'>'+t+'</option>'}).join('')
      +'</select>';
    let valueCell;
    if(f.type==='totp'){
      valueCell='<div><input value="'+escAttr(f.value)+'" placeholder="base32 secret" oninput="updateCredField('+i+',\'value\',this.value)">'
        +'<div style="margin-top:4px"><span class="ctotp" id="totpcode_'+i+'">------</span> <span class="muted" id="totprem_'+i+'"></span>'
        +'<div class="cbar"><i id="totpbar_'+i+'" style="width:0%"></i></div></div></div>';
    } else if(f.type==='password'){
      valueCell='<input type="password" value="'+escAttr(f.value)+'" placeholder="value" oninput="updateCredField('+i+',\'value\',this.value)" ondblclick="this.type=this.type===\'password\'?\'text\':\'password\'" title="double-click to reveal">';
    } else {
      valueCell='<input value="'+escAttr(f.value)+'" placeholder="value" oninput="updateCredField('+i+',\'value\',this.value)">';
    }
    return '<div class="crow">'+labelInput+valueCell+typeSelect
      +'<button onclick="sendCredField('+i+')">Send</button>'
      +'<button onclick="removeCredRow('+i+')">✕</button></div>';
  }).join('');
  if(CREDFIELDS.some(function(f){return f.type==='totp'})) tickTotp();
}

async function tickTotp(){
  for(let i=0;i<CREDFIELDS.length;i++){
    if(CREDFIELDS[i].type!=='totp' || !CREDFIELDS[i].value) continue;
    try{
      const r=await (await fetch('/api/totp?secret='+encodeURIComponent(CREDFIELDS[i].value))).json();
      const codeEl=document.getElementById('totpcode_'+i), remEl=document.getElementById('totprem_'+i), barEl=document.getElementById('totpbar_'+i);
      if(codeEl){ codeEl.textContent=r.code||'------'; }
      if(remEl){ remEl.textContent=(r.remaining||0)+'s'; }
      if(barEl){ barEl.style.width=Math.round(((r.remaining||0)/30)*100)+'%'; }
    }catch(e){}
  }
  CREDTIMER=setTimeout(tickTotp,1000);
}

async function sendCredField(i){
  const f=CREDFIELDS[i];
  let text=f.value;
  if(f.type==='totp'){
    const r=await (await fetch('/api/totp?secret='+encodeURIComponent(f.value))).json();
    text=r.code||'';
  }
  const r=await (await fetch('/api/creds_type',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({text:text})})).json();
  $('log').textContent=r.ok?('sent "'+esc(f.label)+'" to the focused field'):('send failed: '+esc(r.out||''));
}
async function saveCreds(){
  const pkg=$('credPkg').value.trim();
  if(!pkg){ alert('enter a package name'); return; }
  const r=await (await fetch('/api/creds',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({pkg:pkg,fields:CREDFIELDS,notes:$('credNotes').value})})).json();
  $('log').textContent=r.ok?'credentials saved for '+esc(pkg):('save failed: '+esc(r.out||''));
}
async function bringFront(){
  const r=await (await fetch('/api/emulator_front',{method:'POST'})).json();
  $('log').textContent=r.out||'';
}
function escAttr(s){ return esc(s).replace(/"/g,'&quot;'); }

async function loadBurpStatus(){
  const port=($('burpPort').value||'8080').trim();
  try{
    const r=await (await fetch('/api/burp_status?port='+encodeURIComponent(port))).json();
    const ownerLabel={mitmproxy:'<span class="ok">mitmproxy</span>',burp:'<span class="ok">Burp</span>',
      other:'<span class="warn">something else</span>',none:'<span class="muted">nothing</span>'}[r.owner]||r.owner;
    $('burpStatus').innerHTML='<div class="row"><b>port :'+esc(r.port)+'</b><span>'+ownerLabel+'</span></div>'
      +'<div class="row"><b>device proxy</b><span>'+esc(r.device_proxy||'—')+'</span></div>';
  }catch(e){ $('burpStatus').innerHTML='<div class="muted">status unavailable</div>'; }
}
async function switchToBurp(){
  const port=($('burpPort').value||'8080').trim();
  $('log').textContent='switching to Burp on :'+port+'…';
  const r=await (await fetch('/api/action',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({action:'burp_switch',arg:port})})).json();
  $('log').textContent=(r.ok?'':'FAILED\n')+(r.out||'done');
  loadBurpStatus();
}
async function switchToMitm(){
  $('log').textContent='switching back to mitmproxy…';
  const r=await (await fetch('/api/action',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({action:'burp_mitm',arg:''})})).json();
  $('log').textContent=(r.ok?'':'FAILED\n')+(r.out||'done');
  loadBurpStatus();
}
function newRepeater(){
  $('repMethod').value='GET'; $('repUrl').value=''; $('repHeaders').value=''; $('repBody').value=''; $('repResign').checked=false;
  $('repResponse').innerHTML='<div class="muted">Blank request — fill this in and hit Send.</div>';
}
async function loadRepeaterFromFlow(i,session){
  const d=await (await fetch('/api/flow?i='+i+(session?'&session='+encodeURIComponent(session):''))).json();
  if(!d||!d.i) return;
  $('repMethod').value=(d.method||'GET').toUpperCase();
  $('repUrl').value=d.scheme+'://'+d.host+d.path;
  const hide=['content-length','host'];
  const hdrLines=Object.entries(d.req_headers||{}).filter(function(kv){return hide.indexOf(kv[0].toLowerCase())===-1})
    .map(function(kv){return kv[0]+': '+kv[1]}).join('\n');
  $('repHeaders').value=hdrLines;
  $('repBody').value=d.req_pretty||d.req_body||'';
  $('repResign').checked=/"macIn"\s*:/.test($('repBody').value);
  $('repResponse').innerHTML='<div class="muted">Loaded from request #'+i+'. Edit anything, then hit Send.</div>';
  tab('repeater');
}
async function sendRepeater(){
  const method=$('repMethod').value, url=$('repUrl').value.trim();
  if(!url){ alert('enter a URL'); return; }
  const headers=$('repHeaders').value, body=$('repBody').value, resign=$('repResign').checked;
  $('repSendBtn').disabled=true;
  $('repResponse').innerHTML='<div class="muted">sending…</div>';
  const r=await (await fetch('/api/repeater_send',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({method:method,url:url,headers:headers,body:body,resign:resign})})).json();
  $('repSendBtn').disabled=false;
  renderRepResponse(r);
  REPHIST.unshift({method:method,url:url,headers:headers,body:body,resign:resign,result:r});
  if(REPHIST.length>25) REPHIST.pop();
  renderRepHistory();
}
function renderRepResponse(r){
  if(!r||!r.ok){ $('repResponse').innerHTML='<div class="warn">Request failed: '+esc(r&&r.error||'unknown error')+'</div>'; return; }
  const hdrs=Object.entries(r.headers||{}).map(function(kv){return kv[0]+': '+kv[1]}).join('\n')||'(none)';
  let pretty=r.body||'';
  try{ pretty=JSON.stringify(JSON.parse(pretty),null,2); }catch(e){}
  $('repResponse').innerHTML='<div class="muted">'+r.status+' · '+r.elapsed_ms+'ms'+(r.resigned?' · macIn re-signed':'')+'</div>'
    +'<h3>Response headers</h3><pre>'+esc(hdrs)+'</pre>'
    +'<h3>Response body</h3><pre>'+esc(pretty)+'</pre>';
}
function renderRepHistory(){
  $('repHistory').innerHTML=REPHIST.map(function(h,idx){
    let path=h.url; try{ path=new URL(h.url).pathname; }catch(e){}
    const st=(h.result&&h.result.ok)?h.result.status:'ERR';
    return '<div class="app" onclick="loadRepHistory('+idx+')"><span>'+esc(h.method)+' '+esc(path)+'</span><small>'+st+'</small></div>';
  }).join('')||'<div class="muted">no sends yet</div>';
}
function loadRepHistory(idx){
  const h=REPHIST[idx]; if(!h) return;
  $('repMethod').value=h.method; $('repUrl').value=h.url; $('repHeaders').value=h.headers; $('repBody').value=h.body; $('repResign').checked=h.resign;
  renderRepResponse(h.result);
}

function theme(){const r=document.documentElement;const d=r.dataset.theme||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');r.dataset.theme=d==='dark'?'light':'dark'}
function tab(n){document.querySelectorAll('.tab').forEach(e=>e.classList.remove('on'));$('t-'+n).classList.add('on');
  document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('on',b.dataset.t===n));
  if(n==='bypass')loadBypass(); if(n==='apps')loadApps(); if(n==='engage'){pollEng();var d=$('engnavdot');if(d)d.style.display='none';} if(n==='install')pollInstall(); if(n==='login'&&!CREDPKG)loadCredsForCurrentTarget(); if(n==='services')loadBurpStatus(); if(n==='sessions')loadSessions();}
function dot(v){return `<span class="dot" style="background:${v?'var(--ok)':'var(--bad)'}"></span>`}
function row(k,v){return `<div class="row"><b>${k}</b><span>${v}</span></div>`}
function esc(s){return (s==null?'':String(s)).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}

// draggable splitter
(function(){let drag=false;const g=$('gut'),d=$('detail');
 g.addEventListener('mousedown',e=>{drag=true;e.preventDefault()});
 addEventListener('mouseup',()=>drag=false);
 addEventListener('mousemove',e=>{if(!drag)return;const w=innerWidth-e.clientX;
   if(w>280&&w<innerWidth-260)d.style.width=w+'px'})})();

// Every client-side bit of state that's scoped to "the current target" and
// would otherwise silently keep filtering/operating on the OLD app after a
// scan/switch/target_switch (from the CLI, dashboard, or an MCP tool - they
// all just change TARGET in config, which /api/status reflects either way).
// Reproduced without this: a stale tree-filter chip left the Traffic tab
// showing "no traffic captured yet" for a live, correctly-hooked new target,
// and the Login tab kept editing the OLD package's stored credentials.
function onTargetChanged(oldT, newT){
  TREEHOST=null; TREEPATH=[]; TREE_OPEN=new Set(); TREE_INIT=false;
  const chip=$('treechip'); if(chip) chip.innerHTML='';
  CUR=null;
  const d=$('detail');
  if(d) d.innerHTML='<div class="muted">Select a request to inspect it here — headers, body, decoded payloads and response.</div>';
  const af=$('appfilter'); if(af) af.value='';
  const q=$('q'); if(q) q.value='';
  CREDPKG=''; CREDFIELDS=[];
  if(document.querySelector('#t-login.on')) loadCredsForCurrentTarget();
  loadReqs();
  pollEng();
  $('log').textContent='target changed: '+(oldT||'(none)')+' → '+newT+' — traffic/login view reset for the new target';
}

async function load(){
  const s=await (await fetch('/api/status')).json();
  if(LAST_TARGET!==null && s.target && s.target!==LAST_TARGET) onTargetChanged(LAST_TARGET, s.target);
  LAST_TARGET = s.target || '';
  $('hdr').innerHTML = s.online?`${dot(true)}${s.device} · Android ${s.android}`:`${dot(false)}emulator offline`;
  $('tgtpill').innerHTML = s.target?`${dot(s.hooks)}${s.target}${s.scope?' · '+s.scope:''}`:'<span class="warn">no target</span>';
  $('env').innerHTML = row('device',s.online?s.device:'<span class="bad">offline</span>')+
    row('root',s.root?'<span class="ok">yes</span>':'<span class="bad">no</span>')+
    row('frida-server',s.frida?'<span class="ok">running</span>':'<span class="warn">stopped</span>')+
    row('proxy',s.proxy||'—')+row('system CA',s.ca?'<span class="ok">installed</span>':'<span class="bad">missing</span>');
  $('svc').innerHTML = row('hooks',s.hooks?'<span class="ok">held</span>':'down')+
    row('capture :8080',s.capture?'<span class="ok">up</span>':'down')+
    row('mitmweb :8081',s.mitmweb?'<span class="ok">up</span>':'down')+
    row('MobSF :8010',s.mobsf?'<span class="ok">up</span>':'down')+
    row('session',s.session||'—')+row('flows',s.flows);
  SEL=s.target||SEL;
}

async function loadReqs(){
  const app=$('appfilter').value;
  ROWS = await (await fetch('/api/requests'+(app?'?app='+encodeURIComponent(app):''))).json();
  const seen = await (await fetch('/api/seen')).json();
  const cur=$('appfilter').value;
  $('appfilter').innerHTML='<option value="">all apps</option>'+
    seen.map(x=>`<option value="${esc(x.app)}" ${x.app===cur?'selected':''}>${esc(x.app)} (${x.flows})</option>`).join('');
  render();
  loadTree();
}
function render(){
  const q=($('q').value||'').toLowerCase();
  const f=ROWS.filter(r=>{
    if(TREEHOST){
      if(r.host!==TREEHOST) return false;
      const prefix=TREEPATH.join('/');
      const rp=(r.tmpl||'').replace(/^\//,'');
      if(prefix && rp!==prefix && rp.indexOf(prefix+'/')!==0) return false;
    }
    return !q||(r.host+r.path+(r.flags||'')+(r.app||'')).toLowerCase().includes(q);
  });
  $('cnt').textContent = f.length? f.length+' shown' : 'no traffic captured yet';
  $('reqs').innerHTML=f.map(r=>`<tr onclick="show(${r.i},this)" class="${CUR===r.i?'sel':''}">
    <td>${r.i}</td><td>${r.status??''}</td><td>${esc(r.method)}</td><td>${esc(r.host)}</td>
    <td class="p" title="${esc(r.path)}">${esc(r.path)}</td>
    <td>${esc(r.app)||'<span class="muted">—</span>'}</td><td>${esc(r.flags)}</td></tr>`).join('');
}
function flowDetailHTML(d, opts){
  opts=opts||{};
  const hdrs=o=>Object.entries(o||{}).map(([k,v])=>`${esc(k)}: ${esc(v)}`).join('\n')||'(none)';
  let h=`<div style="font-family:ui-monospace,monospace;font-size:13px;word-break:break-all">
      <b>${esc(d.method)}</b> ${esc(d.scheme)}://${esc(d.host)}${esc(d.path)}</div>
    <div class="muted" style="margin-top:4px">${d.status??''} · ${esc(d.res_ct||'')} · req ${d.req_len}b / res ${d.res_len}b
      ${d.app?' · '+esc(d.app):''}${d.authenticated?' · auth '+esc(d.auth_scheme):' · <span class="warn">unauthenticated</span>'}</div>`;
  if((d.idor_candidates||[]).length) h+=`<h3>Object references (IDOR candidates)</h3><pre>${esc(d.idor_candidates.join('\n'))}</pre>`;
  if((d.flag_types||[]).length) h+=`<h3>Flags</h3><pre>${esc(d.flag_types.join(', '))}</pre>`;
  if(!opts.readonly) h+=`<div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="primary" onclick="analyze('flow',${d.i})">Analyse this request with Claude</button>
      <button onclick="loadRepeaterFromFlow(${d.i})">Repeat this request</button></div>`;
  else h+=`<div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap">
      <button onclick="loadRepeaterFromFlow(${d.i},'${esc(opts.session||'')}')">Repeat this request</button></div>`;
  h+=`<h3>Request headers</h3><pre>${esc(hdrs(d.req_headers))}</pre>`;
  if(d.req_pretty) h+=`<h3>Request body</h3><pre>${esc(d.req_pretty)}</pre>`;
  (d.req_decoded||[]).forEach(x=>h+=`<h3>Request · ${esc(x.field)} decoded</h3><pre>${esc(x.decoded)}</pre>`);
  h+=`<h3>Response headers</h3><pre>${esc(hdrs(d.res_headers))}</pre>`;
  if(d.res_pretty) h+=`<h3>Response body</h3><pre>${esc(d.res_pretty)}</pre>`;
  (d.res_decoded||[]).forEach(x=>h+=`<h3>Response · ${esc(x.field)} decoded</h3><pre>${esc(x.decoded)}</pre>`);
  return h;
}
async function show(i,tr){
  CUR=i; document.querySelectorAll('#reqs tr').forEach(x=>x.classList.remove('sel'));
  if(tr)tr.classList.add('sel');
  const d=await (await fetch('/api/flow?i='+i)).json();
  if(!d||!d.i){$('detail').innerHTML='<div class="muted">not found</div>';return}
  $('detail').innerHTML=flowDetailHTML(d);
}

// ---------------------------------------------------------------- SESSIONS
// Every past capture session and Claude Code engagement, browsable
// read-only - nothing here is touched by a new scan, so it's always safe
// to come back to. Deliberately separate from the live Traffic tab's state
// (ROWS/TREEHOST/etc.) rather than a "viewing mode" flag on it, so the
// live auto-refresh loops there can never clobber an archived view.
let SESSDATA={sessions:[],engagements:[]}, VIEWSESS=null;
function agoText(sec){
  if(sec<60) return Math.max(0,Math.round(sec))+'s ago';
  const m=Math.round(sec/60); if(m<60) return m+'m ago';
  const h=Math.round(m/60); if(h<24) return h+'h ago';
  return Math.round(h/24)+'d ago';
}
function renderSessLists(){
  const now=Date.now()/1000;
  $('sessCount').textContent='('+SESSDATA.sessions.length+')';
  $('engListCount').textContent='('+SESSDATA.engagements.length+')';
  $('sessList').innerHTML=SESSDATA.sessions.map(s=>
    '<div class="app'+(s.name===VIEWSESS?' sel':'')+'" onclick="viewSession(\''+esc(s.name)+'\')">'
    +'<span>'+(esc(s.target)||'<span class="muted">(unknown target)</span>')+(s.live?' <b class="ok">live</b>':'')+'</span>'
    +'<small>'+s.flows+' flows · '+agoText(now-s.mtime)+'</small></div>').join('') || '<div class="muted">none yet</div>';
  $('engList').innerHTML=SESSDATA.engagements.map(e=>
    '<div class="app"><span>'+esc(e.pkg)+' <small class="muted">'+esc(e.mode||'?')+'</small>'+(e.running?' <b class="ok">running</b>':'')+'</span>'
    +'<small>'+e.findings+' finding'+(e.findings===1?'':'s')+' · '+agoText(now-e.mtime)
    +(e.session_id?' · <a href="javascript:resumeEngagement(\''+esc(e.name)+'\')">resume</a>':' · not resumable')
    +'</small></div>').join('') || '<div class="muted">none yet</div>';
}
async function loadSessions(){
  SESSDATA=await (await fetch('/api/all_sessions')).json();
  renderSessLists();
}
async function viewSession(name){
  VIEWSESS=name; renderSessLists();
  $('sessDetail').innerHTML='<div class="muted">loading…</div>';
  const rows=await (await fetch('/api/requests?session='+encodeURIComponent(name))).json();
  const meta=SESSDATA.sessions.find(s=>s.name===name)||{};
  let h='<div class="muted" style="margin-bottom:8px">'+esc(name)+' · '+esc(meta.target||'unknown target')+' · '+rows.length+' requests'
    +(meta.live?' · <b class="ok">this is the live session</b>':' · archived, read-only')+'</div>';
  h+='<table style="width:100%"><thead><tr><th>#</th><th>st</th><th>method</th><th>host</th><th>path</th></tr></thead><tbody>'
    +rows.slice(0,300).map(r=>'<tr onclick="showSessFlow(\''+esc(name)+'\','+r.i+')" style="cursor:pointer">'
      +'<td>'+r.i+'</td><td>'+(r.status??'')+'</td><td>'+esc(r.method)+'</td><td>'+esc(r.host)+'</td>'
      +'<td class="p" title="'+esc(r.path)+'">'+esc(r.path)+'</td></tr>').join('')
    +'</tbody></table>'
    +(rows.length>300?'<div class="muted" style="margin-top:8px">showing the most recent 300 of '+rows.length+'</div>':'');
  $('sessDetail').innerHTML=h;
}
async function showSessFlow(name,i){
  const d=await (await fetch('/api/flow?i='+i+'&session='+encodeURIComponent(name))).json();
  if(!d||!d.i){$('sessDetail').innerHTML='<div class="muted">not found</div>';return}
  $('sessDetail').innerHTML='<button onclick="viewSession(\''+esc(name)+'\')">← back to '+esc(name)+'</button>'+flowDetailHTML(d,{readonly:true,session:name});
}
async function resumeEngagement(name){
  $('log').textContent='resuming '+name+'…';
  const r=await (await fetch('/api/action',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({action:'engage_resume',arg:name})})).json();
  $('log').textContent=(r.ok?'':'FAILED\n')+(r.out||'done');
}

async function analyze(kind,i){
  const box=$('detail');
  box.innerHTML='<div class="muted">Sending to Claude Code… this can take a minute.</div>';
  $('log').textContent='analysing…';
  const r=await (await fetch('/api/action',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({action:kind==='flow'?'analyze_flow':'analyze_session',arg:i?String(i):''})})).json();
  $('log').textContent=r.ok?'analysis complete':'analysis failed';
  box.innerHTML=`<h3>Claude analysis ${kind==='flow'?'· request #'+i:'· session'}</h3>
    <pre style="max-height:none">${esc(r.out||'no output')}</pre>
    <button onclick="CUR&&show(CUR)">Back to request</button>`;
}

async function loadBypass(){
  const b=await (await fetch('/api/bypass')).json();
  const tog=(k,label,desc,on,dis)=>`<label class="tog">
      <input type="checkbox" ${on?'checked':''} ${dis?'disabled':''} onchange="act('bypass','${k}='+(this.checked?1:0)).then(loadBypass)">
      <div><code>${esc(label)}</code><small>${esc(desc)}</small></div></label>`;
  $('bscripts').innerHTML=b.scripts.map(x=>tog(x.key,x.key,x.desc,x.on,false)).join('');
  $('banti').innerHTML=(b.anti_enabled?'':'<p class="warn" style="margin:0 0 8px">anti-detection is off — enable it on the left to use these</p>')
    + b.anti.map(x=>tog('anti.'+x.key,x.key,x.desc,x.on,!b.anti_enabled)).join('');
}

async function loadApps(){ APPS=await (await fetch('/api/apps')).json(); drawApps(); }
function drawApps(){
  const f=($('appq').value||'').toLowerCase();
  $('apps').innerHTML=APPS.filter(a=>a.pkg.toLowerCase().includes(f)).map(a=>
    `<div class="app ${a.pkg===SEL?'sel':''}" onclick="pick('${esc(a.pkg)}')">
      <span>${esc(a.pkg)}</span>${a.running?'<small>running</small>':''}</div>`).join('')||'<div class="muted">no matches</div>';
}
async function pick(p){SEL=p;drawApps();
  if(confirm('Switch capture to '+p+'?\n\nThis stops the current capture, starts a fresh session, and launches '+p+' hooked.')){
    tab('traffic'); await act('switch',p); setTimeout(()=>{load();loadReqs()},4000);
  } else { await act('target',p); }  // just set target without switching
  load();
}

async function act(a,arg){
  $('log').textContent=`running ${a}…`;
  const r=await (await fetch('/api/action',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({action:a,arg:arg||''})})).json();
  $('log').textContent=(r.ok?'':'FAILED\n')+(r.out||'done');
  setTimeout(load,1200); return r;
}



let SCANTIMER=null, SCANAPPSLOADED=false;
async function openScan(){
  $('scanLog').textContent='';
  $('scanStartBtn').disabled=false;
  try{ const st=await (await fetch('/api/status')).json(); $('scanScopeIn').value=st.scope||''; $('scanSrc').value=''; }
  catch(e){}
  $('scanOverlay').classList.add('on');
  if(!SCANAPPSLOADED){ SCANAPPSLOADED=true; loadScanApps(); }
}
function closeScan(){ $('scanOverlay').classList.remove('on'); clearTimeout(SCANTIMER); }
async function loadScanApps(){
  const apps=await (await fetch('/api/apps')).json();
  $('scanApps').innerHTML=apps.map(function(a){
    return '<div class="app" onclick="pickScanApp(\''+esc(a.pkg)+'\')"><span>'+esc(a.pkg)+'</span>'
      +(a.running?'<small>running</small>':'')+'</div>';
  }).join('')||'<div class="muted">no third-party apps found</div>';
}
function pickScanApp(pkg){ $('scanSrc').value=pkg; }
async function startScan(){
  const source=$('scanSrc').value.trim(), scope=$('scanScopeIn').value.trim();
  $('scanStartBtn').disabled=true;
  $('scanLog').textContent='starting…';
  await fetch('/api/new_scan',{method:'POST',headers:{'content-type':'application/json'},
    body:JSON.stringify({source:source,scope:scope})});
  pollScan();
}
async function pollScan(){
  const r=await (await fetch('/api/scan_status')).json();
  $('scanLog').textContent=r.log||'starting…';
  $('scanLog').scrollTop=$('scanLog').scrollHeight;
  clearTimeout(SCANTIMER);
  if(r.running){
    SCANTIMER=setTimeout(pollScan,2000);
  } else {
    $('scanStartBtn').disabled=false;
    if(r.log && r.log.indexOf('Ready')!==-1){
      setTimeout(function(){ closeScan(); tab('traffic'); load(); loadReqs(); }, 1200);
    }
  }
}

let ENGTIMER=null, LASTSEENFINDING=null, ENGPOLLING=false;
function sevClass(sev){const k=(sev||'').toLowerCase();return ['critical','high','medium','low','info'].includes(k)?'sev-'+k:'';}
function ageText(min){if(min<1)return 'just now';if(min<60)return min+'m ago';const h=Math.floor(min/60);if(h<24)return h+'h ago';return Math.floor(h/24)+'d ago';}
function renderEngFindings(list){
  $('engcount').textContent=list.length?('('+list.length+')'):'';
  $('engfindings').innerHTML=list.map(function(f){
    const fresh=f.age_min<15?' fresh':'';
    return '<div class="finding-row'+fresh+'" onclick="showFinding(\''+esc(f.file)+'\')">'
      +(f.severity?'<span class="sev '+sevClass(f.severity)+'">'+esc(f.severity)+'</span>':'')
      +'<span class="ftitle">'+esc(f.title)+'</span>'
      +'<span class="fage">'+ageText(f.age_min)+'</span></div>';
  }).join('')||'<div class="muted">none yet…</div>';
}
async function pollEng(){
  ENGPOLLING=true;
  const e=await (await fetch('/api/engagement')).json();
  if(!e.engagement){$('engmeta').innerHTML='<span class="muted">No engagement yet.</span>';clearTimeout(ENGTIMER);ENGTIMER=setTimeout(pollEng,8000);return;}
  const modeLabel=e.mode==='interactive'?'interactive session':'auto-scan';
  $('engmeta').innerHTML='<b>'+esc(e.engagement)+'</b> · '+modeLabel+' · '+(e.running?'<span class="ok">active…</span>':'<span class="muted">idle</span>')+' · '+e.findings.length+' findings';
  if(e.latest){
    $('enghero').innerHTML='<div class="hero" onclick="showFinding(\''+esc(e.latest.file)+'\')">'
      +'<div class="muted">Latest finding · '+ageText(e.latest.age_min)+'</div>'
      +'<div class="htitle">'+(e.latest.severity?'<span class="sev '+sevClass(e.latest.severity)+'">'+esc(e.latest.severity)+'</span>':'')+esc(e.latest.title)+'</div></div>';
  } else { $('enghero').innerHTML=''; }
  renderEngFindings(e.findings);
  $('engactivity').textContent=e.activity||(e.mode==='interactive'?'(interactive session — activity streams to the Terminal window, not here; findings still update live on the left)':'(waiting for the agent…)');

  // Nav badge + auto-open when a genuinely NEW finding shows up (not on first load).
  if(e.latest){
    if(LASTSEENFINDING!==null && e.latest.file!==LASTSEENFINDING){
      $('engnavdot').style.display='inline-block';
      if(document.querySelector('#t-engage.on')) showFinding(e.latest.file);
    }
    LASTSEENFINDING=e.latest.file;
  }
  clearTimeout(ENGTIMER);
  ENGTIMER=setTimeout(pollEng, e.running?5000:12000);   // keep polling even when idle - an interactive session's "running" detection can lag
}
async function showFinding(file){
  const r=await (await fetch('/api/finding?file='+encodeURIComponent(file))).json();
  $('engdetail').innerHTML='<button onclick="pollEng()">← back to activity</button><pre style="max-height:none">'+esc(r.text||'')+'</pre>';
  if($('engnavdot')) $('engnavdot').style.display='none';
}


