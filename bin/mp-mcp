#!/usr/bin/env python3
"""
MCP server for the mobile pentest lab: traffic analysis PLUS full control
plane (scan/switch/install, bypass toggles, Burp/MobSF, credential push,
Claude Code engagements).

Wires the lab straight into a Claude Code session: instead of running `mp`
commands by hand, Claude can query the live capture and drive the lab
directly — list flows, pull one request in full, start a scan, toggle a
bypass module, switch target, push a stored credential into a focused field.

Speaks MCP over stdio as newline-delimited JSON-RPC, implemented directly so
the server has no dependencies beyond the standard library.

Register once:
  claude mcp add --scope user mobix ~/mobile-pentest/bin/mp-mcp

Scope, deliberately:
- The `traffic_*` tools are read-only.
- Every mutating tool below shells out to the same whitelisted `mp` / helper-
  script commands the CLI and web dashboard already use — no new code paths,
  no free-form shell. Package names and hosts are regex-validated before
  they reach a subprocess argv (never a shell string).
- Raw shell (`mp shell`), objection/logcat (interactive, no clean
  request/response shape) and any tool that would return a plaintext stored
  credential are intentionally NOT exposed here. `creds_list` shows only
  labels/types (passwords masked, TOTP shown as a live rotating code exactly
  like `creds.py show` without `--reveal`); `creds_send` types a stored value
  into the on-device field currently focused without ever returning it.
- Every write here is real: `target_scan`, `target_switch`, `target_install`
  force-stop whatever was previously hooked and start a fresh capture
  session, same as the CLI/dashboard. Only point this at devices/apps you
  are authorised to test.
"""
from __future__ import annotations

import base64
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("MP_ROOT", Path.home() / "mobile-pentest"))
LOOT = ROOT / "loot"
SCRIPTS = ROOT / "scripts"
MP = str(ROOT / "bin" / "mp")
PROTOCOL_DEFAULT = "2025-06-18"
MAX_BODY = 6000
PKG_RE = re.compile(r"^[A-Za-z0-9_.]{1,128}$")
HOST_RE = re.compile(r"^[A-Za-z0-9_.,:-]{0,200}$")
LABEL_RE = re.compile(r"^[^\x00-\x1f]{1,80}$")
BYPASS_KEY_RE = re.compile(r"^(anti\.)?[A-Za-z0-9_.-]{1,40}$")
PORT_RE = re.compile(r"^[0-9]{1,5}$")


def err(msg: str) -> None:
    print(f"[mp-mcp] {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------- data access
def sessions() -> list[Path]:
    return sorted((d for d in LOOT.glob("session-*") if (d / "flows.jsonl").exists()),
                  key=lambda p: p.stat().st_mtime, reverse=True)


def live_session() -> Path | None:
    """Prefer wherever the running proxy is writing - but only once it has
    captured something. An empty live session (or one scoped so nothing
    matches) must not mask earlier sessions that do have traffic."""
    live = None
    try:
        out = subprocess.run(
            ["bash", "-c",
             "ps -eo args | grep '[m]itmdump' | tr ' ' '\\n' | grep -m1 '^feedout=' | cut -d= -f2-"],
            capture_output=True, text=True, timeout=10).stdout.strip()
        if out:
            cand = Path(out.splitlines()[-1])
            f = cand / "flows.jsonl"
            if f.exists() and f.stat().st_size:
                return cand
            live = cand if cand.exists() else None
    except Exception:
        pass
    for s in sessions():
        if (s / "flows.jsonl").stat().st_size:
            return s
    return live


def resolve(name: str | None) -> Path | None:
    if not name:
        return live_session()
    p = Path(name)
    if p.is_dir():
        return p
    p = LOOT / name
    return p if p.is_dir() else None


def load(sess: Path) -> list[dict]:
    f = sess / "flows.jsonl"
    if not f.exists():
        return []
    rows = []
    for line in f.open():
        try:
            rows.append(json.loads(line))
        except Exception:
            continue
    return rows


def decode_wrapped(txt: str) -> list[dict]:
    """Surface base64-wrapped payloads (requestBody/responseBody and friends)."""
    out = []
    if not txt:
        return out
    try:
        doc = json.loads(txt)
    except Exception:
        return out
    if not isinstance(doc, dict):
        return out
    for k in ("requestBody", "responseBody", "data", "payload"):
        v = doc.get(k)
        if isinstance(v, str) and len(v) > 8:
            try:
                dec = base64.b64decode(v, validate=True).decode("utf-8", "replace")
            except Exception:
                continue
            if dec.strip()[:1] in "[{\"":
                try:
                    dec = json.dumps(json.loads(dec), ensure_ascii=False, indent=2)
                except Exception:
                    pass
                out.append({"field": k, "decoded": dec[:MAX_BODY]})
    return out


def clip(s, n=MAX_BODY):
    s = s or ""
    return s if len(s) <= n else s[:n] + f"\n…[{len(s)-n} more bytes]"


# ---------------------------------------------------------------- control-plane helpers
def sh(cmd: list[str], timeout: int = 60) -> tuple[int, str]:
    """Run an argv list (never a shell string) and return (rc, combined output)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()
    except subprocess.TimeoutExpired:
        return -1, f"timed out after {timeout}s"
    except Exception as e:
        return -1, str(e)


def device_serial() -> str:
    """Same resolution env.sh gives the CLI/dashboard (adb devices, falling
    back to asking mumu-cli for the port), so all three surfaces agree."""
    rc, out = sh(["bash", "-c", f'. "{SCRIPTS}/env.sh"; echo "$MP_DEVICE"'], 20)
    return out.strip().splitlines()[-1] if out.strip() else "emulator-5554"


def adb(args: list[str], timeout: int = 20) -> str:
    return sh(["adb", "-s", device_serial(), *args], timeout)[1]


def conf() -> dict:
    d = {}
    f = ROOT / "config"
    if f.exists():
        for line in f.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                d[k.strip()] = v.strip().strip('"')
    return d


def result(ok: bool, out: str) -> str:
    return json.dumps({"ok": ok, "out": out}, ensure_ascii=False)


def bad(msg: str) -> str:
    return json.dumps({"ok": False, "out": msg})


# ---------------------------------------------------------------- read-only lab state
def t_lab_status(_) -> str:
    dev = device_serial()
    online = "device" in adb(["get-state"], 8)
    c = conf()
    st = {
        "device": dev if online else None,
        "online": online,
        "android": adb(["shell", "getprop", "ro.build.version.release"], 8).strip() if online else "",
        "abi": adb(["shell", "getprop", "ro.product.cpu.abi"], 8).strip() if online else "",
        "root": online and adb(["shell", "id", "-u"], 8).strip() == "0",
        "frida_server_running": online and bool(adb(["shell", "pgrep", "-f", "frida-server"], 8).strip()),
        "device_proxy": adb(["shell", "settings", "get", "global", "http_proxy"], 8).strip() if online else "",
        "system_ca_installed": online and "No such" not in adb(
            ["shell", "ls", "/system/etc/security/cacerts/c8750f0d.0"], 8),
        "target": c.get("TARGET", ""),
        "scope": c.get("SCOPE", ""),
    }
    return json.dumps(st, indent=2)


def t_lab_apps(_) -> str:
    """Packages installed ON THE EMULATOR (never host/macOS apps)."""
    out = adb(["shell", "pm", "list", "packages", "-3"], 25)
    pkgs = sorted(l.replace("package:", "").strip()
                  for l in out.splitlines() if l.startswith("package:"))
    running = adb(["shell", "ps", "-A", "-o", "NAME"], 20)
    apps = [{"pkg": p, "running": p in running} for p in pkgs if PKG_RE.match(p)]
    return json.dumps(apps, indent=2)


def t_bypass_list(_) -> str:
    rc, out = sh(["python3", str(SCRIPTS / "bypass.py"), "--list"], 30)
    try:
        return json.dumps(json.loads(out[out.index("{"):]), indent=2)
    except Exception:
        return bad(out or "bypass.py --list failed")


def t_engage_findings(a: dict) -> str:
    base = ROOT / "engagements"
    engs = sorted((d for d in base.glob("*") if d.is_dir()),
                  key=lambda p: p.stat().st_mtime, reverse=True) if base.exists() else []
    if not engs:
        return json.dumps({"engagement": None, "findings": []})
    e = engs[0]
    fdir = e / "findings"
    out = []
    for f in sorted(fdir.glob("*.md"), reverse=True) if fdir.exists() else []:
        out.append({"file": f.name, "text": f.read_text()[:6000] if a.get("full_text") else None,
                    "excerpt": f.read_text()[:400]})
    return json.dumps({"engagement": e.name, "count": len(out), "findings": out}, indent=2, ensure_ascii=False)


# ---------------------------------------------------------------- targeting / lifecycle
def t_lab_up(_) -> str:
    rc, out = sh([MP, "up"], 300)
    return result(rc == 0, out)


def t_lab_down(_) -> str:
    rc, out = sh([MP, "down"], 300)
    return result(rc == 0, out)


def t_lab_stop(_) -> str:
    rc, out = sh([MP, "stop"], 300)
    return result(rc == 0, out)


def t_lab_go(_) -> str:
    """Boot emulator if needed, hook the current target, start capture (reuses a live capture)."""
    rc, out = sh([MP, "go"], 400)
    return result(rc == 0, out)


def t_target_set(a: dict) -> str:
    pkg = a.get("pkg") or ""
    if not PKG_RE.match(pkg):
        return bad("invalid package name")
    rc, out = sh([MP, "target", pkg], 30)
    return result(rc == 0, out)


def t_target_switch(a: dict) -> str:
    """Switch capture to an ALREADY-INSTALLED app: force-stops the old capture,
    starts a fresh session, launches the new target hooked."""
    pkg = a.get("pkg") or ""
    if not PKG_RE.match(pkg):
        return bad("invalid package name")
    rc, out = sh([MP, "switch", pkg], 500)
    return result(rc == 0, out)


def t_target_scan(a: dict) -> str:
    """Full `mp scan` flow: environment up, resolve/install the target if
    needed, force-stop whatever was hooked before, fresh capture session,
    launch hooked. Requires an explicit target - no interactive picker here."""
    src = a.get("target") or ""
    if not src:
        return bad("target is required (package name, .apk/.xapk path, APK URL, or Play Store link)")
    rc, out = sh([MP, "scan", src], 600)
    return result(rc == 0, out)


def t_target_scope(a: dict) -> str:
    host = a.get("host") or ""
    if not HOST_RE.match(host):
        return bad("invalid scope")
    rc, out = sh([MP, "scope", host], 30)
    return result(rc == 0, out)


def t_target_install(a: dict) -> str:
    src = a.get("source") or ""
    if not src:
        return bad("source is required (.apk/.xapk path, APK URL, or Play Store link)")
    args = [str(SCRIPTS / "install-app.sh"), src]
    if a.get("passive"):
        args.append("--passive")
    rc, out = sh(args, 600)
    return result(rc == 0, out)


def t_target_pull(a: dict) -> str:
    pkg = a.get("pkg") or conf().get("TARGET", "")
    if not PKG_RE.match(pkg or ""):
        return bad("invalid package name")
    rc, out = sh([MP, "pull", pkg], 600)
    return result(rc == 0, out)


def t_target_launch(a: dict) -> str:
    pkg = a.get("pkg") or conf().get("TARGET", "")
    if not PKG_RE.match(pkg or ""):
        return bad("invalid package name")
    rc, out = sh([MP, "launch", pkg], 400)
    return result(rc == 0, out)


def t_target_static(a: dict) -> str:
    apk = a.get("apk") or ""
    args = [MP, "static"] + ([apk] if apk else [])
    rc, out = sh(args, 400)
    return result(rc == 0, out)


# ---------------------------------------------------------------- bypass
def t_bypass_set(a: dict) -> str:
    key = a.get("key") or ""
    if not BYPASS_KEY_RE.match(key):
        return bad("invalid module key")
    on = bool(a.get("on"))
    rc, out = sh(["python3", str(SCRIPTS / "bypass.py"), "--set", f"{key}={'1' if on else '0'}"], 30)
    return result(rc == 0, out or f"{key} -> {'on' if on else 'off'} (applies on next launch)")


def t_bypass_reset(_) -> str:
    rc, out = sh(["python3", str(SCRIPTS / "bypass.py"), "--reset"], 30)
    return result(rc == 0, "all bypass modules re-enabled")


# ---------------------------------------------------------------- Burp / MobSF
def t_burp_switch(a: dict) -> str:
    port = str(a.get("port") or "8080")
    if not PORT_RE.match(port) or not (1 <= int(port) <= 65535):
        return bad("invalid port")
    rc, out = sh([MP, "burp", port], 30)
    return result(rc == 0, out)


def t_burp_mitm(_) -> str:
    rc, out = sh([MP, "burp", "--mitm"], 30)
    return result(rc == 0, out)


def t_mobsf_start(_) -> str:
    rc, out = sh([MP, "mobsf", "start"], 300)
    return result(rc == 0, out)


# ---------------------------------------------------------------- Claude Code engagements
def t_engage_start(a: dict) -> str:
    pkg = a.get("pkg") or conf().get("TARGET", "")
    if not PKG_RE.match(pkg or ""):
        return bad("invalid package name")
    mode = a.get("mode") or "auto"
    if mode == "auto":
        rc, out = sh([MP, "engage", pkg, "--auto"], 120)
    elif mode == "interactive":
        rc, out = sh([MP, "engage", pkg], 60)
    else:
        return bad("mode must be 'auto' or 'interactive'")
    return result(rc == 0, out)


def t_engage_stop(_) -> str:
    rc, out = sh([MP, "engage", "--stop"], 60)
    return result(rc == 0, out)


def t_engage_resume(a: dict) -> str:
    """Reopens a Terminal window running `claude --resume <id>` in that
    engagement's folder - same as the dashboard's Sessions tab Resume link."""
    name = a.get("name") or ""
    if not re.match(r"^[A-Za-z0-9_.-]{1,160}$", name) or not (ROOT / "engagements" / name).is_dir():
        return bad("unknown engagement - see lab_sessions for valid names")
    rc, out = sh([MP, "engage", "--resume", name], 30)
    return result(rc == 0, out)


def session_target(d: Path) -> str:
    tf = d / ".target"
    if tf.exists():
        return tf.read_text().strip()
    rows = load(d)
    counts: dict[str, int] = {}
    for r in rows:
        a = r.get("app") or ""
        if a:
            counts[a] = counts.get(a, 0) + 1
    return max(counts, key=counts.get) if counts else ""


def t_lab_sessions(_) -> str:
    """Every past capture session (target, flow count, age) and Claude Code
    engagement (mode, findings, resumable session id) - nothing here is ever
    deleted by a new scan. Pass an engagement's 'name' to engage_resume."""
    live = live_session()
    sess_out = []
    for d in sessions():
        rows = load(d)
        sess_out.append({
            "name": d.name, "target": session_target(d), "flows": len(rows),
            "live": live is not None and d.resolve() == live.resolve(),
        })
    eng_out = []
    base = ROOT / "engagements"
    if base.exists():
        for d in sorted((p for p in base.glob("*") if p.is_dir()),
                         key=lambda p: p.stat().st_mtime, reverse=True):
            pkg = d.name.rsplit("_", 1)[0] if "_" in d.name else d.name
            sid_f, mode_f, pid_f = d / ".session_id", d / ".mode", d / ".agent.pid"
            fdir = d / "findings"
            running = False
            if pid_f.exists():
                try:
                    os.kill(int(pid_f.read_text().strip()), 0); running = True
                except Exception:
                    running = False
            eng_out.append({
                "name": d.name, "pkg": pkg,
                "session_id": sid_f.read_text().strip() if sid_f.exists() else "",
                "mode": mode_f.read_text().strip() if mode_f.exists() else "",
                "findings": len(list(fdir.glob("*.md"))) if fdir.exists() else 0,
                "running": running,
            })
    return json.dumps({"sessions": sess_out, "engagements": eng_out}, indent=2)


# ---------------------------------------------------------------- credentials
# No tool here ever returns a stored plaintext password/TOTP secret - see the
# module docstring. creds_list mirrors `creds.py show` (masked); creds_send
# mirrors `creds.py type` (pushes into the device, never echoes the value).
def t_creds_list(a: dict) -> str:
    pkg = a.get("pkg") or ""
    if not PKG_RE.match(pkg):
        return bad("invalid package name")
    rc, out = sh([str(SCRIPTS / "creds.py"), "show", pkg], 15)
    return result(rc == 0, out)


def t_creds_set(a: dict) -> str:
    pkg, label, value = a.get("pkg") or "", a.get("label") or "", a.get("value")
    if not PKG_RE.match(pkg):
        return bad("invalid package name")
    if not LABEL_RE.match(label):
        return bad("invalid label")
    if value is None:
        return bad("value is required")
    ftype = a.get("type") if a.get("type") in ("text", "password", "totp") else "text"
    rc, out = sh([str(SCRIPTS / "creds.py"), "set", pkg, label, str(value), "--type", ftype], 15)
    return result(rc == 0, out)


def t_creds_remove(a: dict) -> str:
    pkg, label = a.get("pkg") or "", a.get("label") or ""
    if not PKG_RE.match(pkg) or not LABEL_RE.match(label):
        return bad("invalid package name or label")
    rc, out = sh([str(SCRIPTS / "creds.py"), "rm", pkg, label], 15)
    return result(rc == 0, out)


def t_creds_send(a: dict) -> str:
    """Tap the target field on the device FIRST, then call this - it types
    that field's stored value (or, for a totp field, the current code) into
    whatever is focused. Never returns the value itself."""
    pkg, label = a.get("pkg") or "", a.get("label") or ""
    if not PKG_RE.match(pkg) or not LABEL_RE.match(label):
        return bad("invalid package name or label")
    rc, out = sh([str(SCRIPTS / "creds.py"), "type", pkg, label], 15)
    return result(rc == 0, "sent" if rc == 0 else out)


def t_creds_bring_front(_) -> str:
    rc, out = sh([str(SCRIPTS / "creds.py"), "front"], 15)
    return result(rc == 0, out or "brought MuMu Player Pro to the front")


# ---------------------------------------------------------------- tools
def t_status(_) -> str:
    s = live_session()
    rows = load(s) if s else []
    hooked = ""
    f = ROOT / ".active-app"
    if f.exists():
        hooked = f.read_text().strip()
    cfg = {}
    c = ROOT / "config"
    if c.exists():
        for line in c.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                cfg[k.strip()] = v.strip().strip('"')
    hosts = {}
    apps = {}
    for r in rows:
        hosts[r.get("host", "")] = hosts.get(r.get("host", ""), 0) + 1
        apps[r.get("app") or "(untagged)"] = apps.get(r.get("app") or "(untagged)", 0) + 1
    return json.dumps({
        "session": s.name if s else None,
        "flows": len(rows),
        "target": cfg.get("TARGET", ""),
        "scope": cfg.get("SCOPE", ""),
        "hooked_app": hooked,
        "hosts": hosts,
        "apps": apps,
        "other_sessions": [d.name for d in sessions()[:10]],
    }, indent=2)


def t_sessions(_) -> str:
    out = []
    for d in sessions()[:20]:
        rows = load(d)
        out.append({"session": d.name, "flows": len(rows),
                    "hosts": sorted({r.get("host", "") for r in rows})[:8],
                    "has_brief": (d / "BRIEF.md").exists()})
    return json.dumps(out, indent=2)


def t_flows(a: dict) -> str:
    sess = resolve(a.get("session"))
    if not sess:
        return "no capture session found"
    rows = load(sess)
    app = a.get("app")
    host = a.get("host")
    method = (a.get("method") or "").upper()
    contains = (a.get("contains") or "").lower()
    unauth = a.get("unauthenticated_only")
    limit = int(a.get("limit") or 100)

    sel = []
    for r in rows:
        if app and (r.get("app") or "") != app:
            continue
        if host and host.lower() not in (r.get("host") or "").lower():
            continue
        if method and (r.get("method") or "") != method:
            continue
        if unauth and r.get("authenticated"):
            continue
        if contains:
            hay = " ".join([r.get("path") or "", r.get("req_body") or "",
                            r.get("res_body") or "", json.dumps(r.get("req_headers") or {})]).lower()
            if contains not in hay:
                continue
        sel.append({
            "i": r.get("i"), "method": r.get("method"), "host": r.get("host"),
            "path": r.get("path"), "status": r.get("status"),
            "app": r.get("app") or "", "auth": r.get("auth_scheme") or "",
            "req_len": r.get("req_len"), "res_len": r.get("res_len"),
            "flags": r.get("flag_types") or [], "idor": r.get("idor_candidates") or [],
        })
    return json.dumps({"session": sess.name, "matched": len(sel),
                       "flows": sel[-limit:]}, indent=2)


def t_flow(a: dict) -> str:
    sess = resolve(a.get("session"))
    if not sess:
        return "no capture session found"
    try:
        idx = int(a.get("index"))
    except (TypeError, ValueError):
        return "index must be an integer"
    for r in load(sess):
        if r.get("i") != idx:
            continue
        out = {k: r.get(k) for k in
               ("i", "ts", "method", "scheme", "host", "path", "query", "status",
                "app", "authenticated", "auth_scheme", "req_ct", "res_ct",
                "req_len", "res_len", "flag_types", "idor_candidates",
                "req_headers", "res_headers")}
        out["req_body"] = clip(r.get("req_body"))
        out["res_body"] = clip(r.get("res_body"))
        out["req_decoded"] = decode_wrapped(r.get("req_body"))
        out["res_decoded"] = decode_wrapped(r.get("res_body"))
        return json.dumps(out, indent=2, ensure_ascii=False)
    return f"no request #{idx} in {sess.name}"


def t_search(a: dict) -> str:
    sess = resolve(a.get("session"))
    if not sess:
        return "no capture session found"
    q = (a.get("query") or "").lower()
    if not q:
        return "query is required"
    hits = []
    for r in load(sess):
        blob = " ".join([
            r.get("path") or "", json.dumps(r.get("req_headers") or {}),
            json.dumps(r.get("res_headers") or {}),
            r.get("req_body") or "", r.get("res_body") or "",
        ])
        low = blob.lower()
        if q in low:
            i = low.index(q)
            hits.append({"i": r.get("i"), "method": r.get("method"),
                         "host": r.get("host"), "path": r.get("path"),
                         "status": r.get("status"),
                         "context": blob[max(0, i - 90): i + 190]})
        if len(hits) >= int(a.get("limit") or 30):
            break
    return json.dumps({"session": sess.name, "hits": len(hits), "matches": hits},
                      indent=2, ensure_ascii=False)


def t_brief(a: dict) -> str:
    sess = resolve(a.get("session"))
    if not sess:
        return "no capture session found"
    if a.get("rebuild") or not (sess / "BRIEF.md").exists():
        subprocess.run(["python3", str(SCRIPTS / "brief.py"), str(sess)],
                       capture_output=True, text=True, timeout=180)
    f = sess / "BRIEF.md"
    return f.read_text() if f.exists() else "brief could not be generated"


TOOLS = [
    {"name": "traffic_status",
