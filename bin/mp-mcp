BY_NAME = {t["name"]: t for t in TOOLS}


# ---------------------------------------------------------------- JSON-RPC
def reply(mid, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": mid}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def handle(msg: dict) -> None:
    m = msg.get("method")
    mid = msg.get("id")

    if m == "initialize":
        ver = (msg.get("params") or {}).get("protocolVersion") or PROTOCOL_DEFAULT
        return reply(mid, {
            "protocolVersion": ver,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "mobix", "version": "2.0.0"},
        })
    if m in ("notifications/initialized", "initialized"):
        return  # notification: no reply
    if m == "ping":
        return reply(mid, {})
    if m == "tools/list":
        return reply(mid, {"tools": [{k: t[k] for k in ("name", "description", "inputSchema")}
                                     for t in TOOLS]})
    if m == "tools/call":
        p = msg.get("params") or {}
        name = p.get("name")
        args = p.get("arguments") or {}
        tool = BY_NAME.get(name)
        if not tool:
            return reply(mid, error={"code": -32602, "message": f"unknown tool: {name}"})
        try:
            text = tool["fn"](args)
        except Exception as e:
            err(f"{name} failed: {e}")
            return reply(mid, {"content": [{"type": "text", "text": f"error: {e}"}],
                               "isError": True})
        return reply(mid, {"content": [{"type": "text", "text": text}]})
    if mid is not None:
        return reply(mid, error={"code": -32601, "message": f"method not found: {m}"})


def main() -> int:
    err(f"mobix control plane - traffic from {LOOT}, mp at {MP}")
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except Exception as e:
            err(f"bad json: {e}")
            continue
        try:
            handle(msg)
        except Exception as e:
            err(f"handler error: {e}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
